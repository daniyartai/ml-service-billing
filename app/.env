# Конфигурация сервиса app (передаётся через env_file в docker-compose)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Подключение к базе данных (сервис database из docker-compose)
DATABASE_URL=postgresql://ml_user:ml_password@database:5432/ml_service

# Подключение к брокеру сообщений (сервис rabbitmq из docker-compose)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
